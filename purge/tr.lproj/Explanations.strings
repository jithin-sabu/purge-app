/* Türkçe görüntülenen metin. Eşleştirme kuralları ve risk etiketleri explanations.json içinde kalır. */

"Adobe Media Cache Files" = "Adobe Medya Önbellek Dosyaları";
"Rendered previews and conformed audio from Premiere Pro and After Effects. The apps rebuild them on next launch, which can take minutes on large projects." = "Premiere Pro ve After Effects'in işlenmiş önizlemeleri ve uyarlanmış sesleri. Uygulamalar bunları bir sonraki açılışta yeniden oluşturur; büyük projelerde bu dakikalar sürebilir.";

"Adobe Media Cache Database" = "Adobe Medya Önbellek Veritabanı";
"the index adobe uses to track media cache files. safe to clean. rebuilds alongside the cache." = "Adobe'nin medya önbellek dosyalarını izlemek için kullandığı dizin. Temizlemek güvenlidir. Önbellekle birlikte yeniden oluşur.";

"Adobe Camera Raw Cache" = "Adobe Camera Raw Önbelleği";
"photoshop, lightroom and bridge cache raw previews here. safe to clean. rebuilds automatically when you open images." = "Photoshop, Lightroom ve Bridge ham önizlemeleri burada önbelleğe alır. Temizlemek güvenlidir. Görselleri açtığınızda otomatik olarak yeniden oluşur.";

"Android Build Cache" = "Android Derleme Önbelleği";
"Build caches in ~/.android that the next build recreates. Emulators, the key your phones trust for debugging, and your debug signing key are left alone." = "~/.android içindeki, bir sonraki derlemenin yeniden oluşturduğu derleme önbellekleri. Emülatörlere, telefonlarınızın hata ayıklama için güvendiği anahtara ve hata ayıklama imzalama anahtarınıza dokunulmaz.";

"Perplexity App Updater" = "Perplexity Uygulama Güncelleyicisi";
"These are temporary files used to update the Perplexity AI app. They are regenerated automatically whenever Perplexity checks for a new version." = "Bunlar Perplexity AI uygulamasını güncellemek için kullanılan geçici dosyalardır. Perplexity yeni sürümü her denetlediğinde otomatik olarak yeniden oluşturulur.";

"Blender 3D App" = "Blender 3D Uygulaması";
"Temporary files Blender saves while you work. Safe to delete; Blender may take a little longer to start the next time you open it." = "Blender'ın siz çalışırken kaydettiği geçici dosyalar. Silmek güvenlidir; Blender bir sonraki açışınızda biraz daha geç başlayabilir.";

"Node.js Dev Tool" = "Node.js Geliştirici Aracı";
"This is a temporary storage folder used by a developer tool that runs on your Mac. It is safe to delete and will be recreated automatically." = "Bu, Mac'inizde çalışan bir geliştirici aracının kullandığı geçici depolama klasörüdür. Silmek güvenlidir ve otomatik olarak yeniden oluşturulur.";

"iCloud Data Sync" = "iCloud Veri Eşitleme";
"Data your Mac uses to sync with iCloud. Nothing is lost from iCloud, but apps must sync again afterwards, which can take time on a slow connection." = "Mac'inizin iCloud ile eşitlemek için kullandığı veriler. iCloud'dan hiçbir şey kaybolmaz ancak uygulamaların sonradan yeniden eşitlenmesi gerekir; yavaş bağlantıda bu zaman alabilir.";

"Claude App Updater" = "Claude Uygulama Güncelleyicisi";
"These are temporary files used to update the Claude AI desktop app. They are recreated automatically each time Claude checks for updates." = "Bunlar Claude AI masaüstü uygulamasını güncellemek için kullanılan geçici dosyalardır. Claude her güncelleme denetlediğinde otomatik olarak yeniden oluşturulur.";

"Apple Accounts Service" = "Apple Hesapları Servisi";
"This supports the system service that manages your Apple ID and connected accounts. Deleting it can sign accounts out and ask you to sign in again." = "Bu, Apple Kimliğinizi ve bağlı hesaplarınızı yöneten sistem servisini destekler. Silmek hesaplarda oturumu kapatabilir ve yeniden oturum açmanızı isteyebilir.";

"Apple Key Service" = "Apple Anahtar Servisi";
"This is used by the Apple background service that handles authentication and security keys. Deleting it can prompt you to re-authenticate." = "Bu, kimlik doğrulama ve güvenlik anahtarlarını yöneten Apple arka plan servisi tarafından kullanılır. Silmek sizden yeniden kimlik doğrulaması isteyebilir.";

"Apple Music Library" = "Apple Music Kitaplığı";
"Temporary data for your Apple Music library. Nothing is lost, but Apple Music may take a while to rebuild your library view." = "Apple Music kitaplığınızın geçici verileri. Hiçbir şey kaybolmaz ancak Apple Music kitaplık görünümünüzü yeniden oluşturması biraz zaman alabilir.";

"App Store Accounts" = "App Store Hesapları";
"This supports the App Store's sign-in and account system. Deleting it can prompt you to sign in to the App Store again." = "Bu, App Store'un oturum açma ve hesap sistemini destekler. Silmek App Store'da yeniden oturum açmanızı isteyebilir.";

"App Store Notifications" = "App Store Bildirimleri";
"This folder stores temporary data related to App Store recommendations and notifications. It is completely safe to delete and will be rebuilt automatically." = "Bu klasör App Store önerileri ve bildirimleriyle ilgili geçici verileri saklar. Silmek tamamen güvenlidir ve otomatik olarak yeniden oluşturulur.";

"Apple Ad Privacy" = "Apple Reklam Gizliliği";
"This is temporary data used by Apple's privacy-focused advertising system. Deleting it is safe and has no effect on your apps or personal data." = "Bu, Apple'ın gizlilik odaklı reklam sisteminin kullandığı geçici verilerdir. Silmek güvenlidir ve uygulamalarınızı veya kişisel verilerinizi etkilemez.";

"Apple ID Service" = "Apple Kimliği Servisi";
"This is used by the service that manages your Apple ID on your Mac. Deleting it can prompt you to sign in to your Apple ID again." = "Bu, Mac'inizde Apple Kimliğinizi yöneten servis tarafından kullanılır. Silmek Apple Kimliğinizle yeniden oturum açmanızı isteyebilir.";

"Apple Media Services" = "Apple Medya Servisleri";
"Temporary data for the App Store, Apple TV and Apple Music. Safe to delete; these services rebuild it as needed." = "App Store, Apple TV ve Apple Music için geçici veriler. Silmek güvenlidir; bu servisler gerektiğinde yeniden oluşturur.";

"App Store Agent" = "App Store Aracısı";
"This contains temporary files used by the App Store to manage downloads and updates in the background. It is safe to delete and will be recreated automatically." = "Bu, App Store'un indirmeleri ve güncellemeleri arka planda yönetmek için kullandığı geçici dosyaları içerir. Silmek güvenlidir ve otomatik olarak yeniden oluşturulur.";

"Siri Assistant" = "Siri Asistanı";
"This folder holds temporary data for Siri on your Mac. Deleting it is completely safe and Siri will rebuild it automatically." = "Bu klasör Mac'inizdeki Siri'nin geçici verilerini tutar. Silmek tamamen güvenlidir ve Siri bunu otomatik olarak yeniden oluşturur.";

"Sign In with Apple" = "Apple ile Giriş Yap";
"This supports the 'Sign in with Apple' feature used by apps and websites. Deleting it can sign you out and require signing in again." = "Bu, uygulamaların ve web sitelerinin kullandığı 'Apple ile Giriş Yap' özelliğini destekler. Silmek oturumunuzu kapatabilir ve yeniden oturum açmanızı gerektirebilir.";

"Apple Beta Program" = "Apple Beta Programı";
"This is temporary data related to Apple's beta software programme. It is safe to delete and will be recreated if you are enrolled in the beta programme." = "Bu, Apple'ın beta yazılım programıyla ilgili geçici verilerdir. Silmek güvenlidir ve beta programına kayıtlıysanız yeniden oluşturulur.";

"iCloud Drive Sync" = "iCloud Drive Eşitleme";
"Used by the service that keeps iCloud Drive in sync. Nothing is lost from iCloud, but your Mac re-checks and re-downloads file state afterwards." = "iCloud Drive'ı eşitlemede tutan servis tarafından kullanılır. iCloud'dan hiçbir şey kaybolmaz ancak Mac'iniz sonradan dosya durumunu yeniden denetler ve yeniden indirir.";

"Apple Business Services" = "Apple Business Servisleri";
"This holds temporary data for Apple's business and organisation account features. It is safe to delete and will be regenerated automatically." = "Bu, Apple'ın iş ve kuruluş hesabı özellikleri için geçici verileri tutar. Silmek güvenlidir ve otomatik olarak yeniden oluşturulur.";

"System Cache Manager" = "Sistem Önbellek Yöneticisi";
"This is a folder used by macOS itself to manage and clean up other temporary files. It is safe to delete." = "Bu, macOS'in diğer geçici dosyaları yönetmek ve temizlemek için kullandığı bir klasördür. Silmek güvenlidir.";

"iCloud Background Service" = "iCloud Arka Plan Servisi";
"This is used by the background service that handles iCloud data on your Mac. Nothing is lost from iCloud, but your Mac will need to re-sync afterwards." = "Bu, Mac'inizdeki iCloud verilerini yöneten arka plan servisi tarafından kullanılır. iCloud'dan hiçbir şey kaybolmaz ancak Mac'inizin sonradan yeniden eşitlenmesi gerekir.";

"Apple Usage Reports" = "Apple Kullanım Raporları";
"This stores temporary data that Apple uses for anonymous usage analytics. Deleting it is completely safe and causes no issues." = "Bu, Apple'ın anonim kullanım analizi için kullandığı geçici verileri saklar. Silmek tamamen güvenlidir ve sorun yaratmaz.";

"Content Type Service" = "İçerik Türü Servisi";
"This is a temporary folder used by a macOS service that categorises content for features like Screen Time and parental controls. It is safe to delete." = "Bu, Ekran Süresi ve ebeveyn denetimleri gibi özellikler için içeriği sınıflandıran bir macOS servisinin kullandığı geçici bir klasördür. Silmek güvenlidir.";

"Contacts & Calendar Sync" = "Kişiler ve Takvim Eşitleme";
"Used by the service that syncs your contacts and calendars. Nothing is lost, but your Mac downloads them again and they may be missing briefly." = "Kişilerinizi ve takvimlerinizi eşitleyen servis tarafından kullanılır. Hiçbir şey kaybolmaz ancak Mac'iniz bunları yeniden indirir ve kısa süreliğine eksik görünebilirler.";

"Focus Mode Service" = "Odaklanma Modu Servisi";
"This is temporary data for your Mac's Focus and Do Not Disturb settings. It is safe to delete and will be recreated automatically." = "Bu, Mac'inizin Odaklanma ve Rahatsız Etmeyin ayarlarının geçici verileridir. Silmek güvenlidir ve otomatik olarak yeniden oluşturulur.";

"Siri Intelligence Engine" = "Siri Zekâ Motoru";
"Apple's on-device intelligence that powers Siri Suggestions and app predictions. Deleting it resets what it has learned about how you use your Mac." = "Siri Önerilerini ve uygulama tahminlerini çalıştıran Apple'ın aygıt üstü zekâsı. Silmek, Mac'i nasıl kullandığınıza dair öğrendiklerini sıfırlar.";

"Apple ML Model Cache" = "Apple ML Model Önbelleği";
"Compiled machine learning models that macOS features such as Photos and Live Text use. macOS compiles them again when needed, using some processor time." = "Fotoğraflar ve Canlı Metin gibi macOS özelliklerinin kullandığı derlenmiş makine öğrenimi modelleri. macOS gerektiğinde bunları yeniden derler ve bir miktar işlemci zamanı kullanır.";

"Feature Permissions" = "Özellik İzinleri";
"This temporary folder helps macOS manage which features and capabilities apps are allowed to use. It is safe to delete and will be rebuilt automatically." = "Bu geçici klasör, macOS'in uygulamaların hangi özellikleri ve yetenekleri kullanabileceğini yönetmesine yardımcı olur. Silmek güvenlidir ve otomatik olarak yeniden oluşturulur.";

"Apple Feedback Logger" = "Apple Geri Bildirim Günlüğü";
"This stores temporary logs that are sent to Apple as diagnostic feedback. Deleting it is completely safe." = "Bu, tanılama geri bildirimi olarak Apple'a gönderilen geçici günlükleri saklar. Silmek tamamen güvenlidir.";

"App Store File Service" = "App Store Dosya Servisi";
"This is used by a background service that helps the App Store manage files on your Mac. It is safe to delete." = "Bu, App Store'un Mac'inizdeki dosyaları yönetmesine yardımcı olan bir arka plan servisi tarafından kullanılır. Silmek güvenlidir.";

"Find My Service" = "Bul Servisi";
"Temporary data used by Find My to track your Apple devices. Nothing is lost, but device locations may take a while to reappear." = "Bul'un Apple aygıtlarınızı izlemek için kullandığı geçici veriler. Hiçbir şey kaybolmaz ancak aygıt konumlarının yeniden görünmesi biraz zaman alabilir.";

"Location Analytics" = "Konum Analizi";
"This is temporary data used by Apple's location analytics system. Deleting it is completely safe and has no effect on Maps or other apps." = "Bu, Apple'ın konum analizi sisteminin kullandığı geçici verilerdir. Silmek tamamen güvenlidir ve Haritalar'ı veya diğer uygulamaları etkilemez.";

"Apple Maps Tile Cache" = "Apple Haritalar Karo Önbelleği";
"Map tiles and place data that Apple Maps has downloaded. Nothing is lost, but Maps downloads them again as you browse, which is slower and uses data." = "Apple Haritalar'ın indirdiği harita karoları ve yer verileri. Hiçbir şey kaybolmaz ancak Haritalar gezindikçe bunları yeniden indirir; bu daha yavaştır ve veri kullanır.";

"macOS Help System" = "macOS Yardım Sistemi";
"This stores temporary data for the built-in macOS Help viewer. It is safe to delete and the Help system will rebuild it when next opened." = "Bu, yerleşik macOS Yardım görüntüleyicisinin geçici verilerini saklar. Silmek güvenlidir ve Yardım sistemi bir sonraki açılışta bunu yeniden oluşturur.";

"Apple Home & HomeKit" = "Apple Ev ve HomeKit";
"Temporary data for the Home app and your connected smart home devices. Nothing is unpaired, but the Home app may be slow or incomplete until it re-syncs." = "Ev uygulamasının ve bağlı akıllı ev aygıtlarınızın geçici verileri. Hiçbir eşleşme kaldırılmaz ancak Ev uygulaması yeniden eşitlenene kadar yavaş veya eksik olabilir.";

"iCloud Notifications" = "iCloud Bildirimleri";
"Temporary data for iCloud notifications. It is rebuilt automatically, but iCloud notifications can be delayed until it is." = "iCloud bildirimlerinin geçici verileri. Otomatik olarak yeniden oluşturulur ancak o zamana kadar iCloud bildirimleri gecikebilir.";

"iTunes & Apple Music" = "iTunes ve Apple Music";
"Temporary data from iTunes and Apple Music, including artwork and media previews. Nothing is lost, but artwork is re-downloaded as you browse." = "iTunes ve Apple Music'in kapak resimleri ve medya önizlemeleri dahil geçici verileri. Hiçbir şey kaybolmaz ancak kapak resimleri gezindikçe yeniden indirilir.";

"Managed App Service" = "Yönetilen Uygulama Servisi";
"This is used by a background service that helps distribute and manage apps, typically in business or school environments. It is safe to delete." = "Bu, uygulamaları dağıtmaya ve yönetmeye yardımcı olan, genellikle iş veya okul ortamlarında kullanılan bir arka plan servisi tarafından kullanılır. Silmek güvenlidir.";

"Background Downloads" = "Arka Plan İndirmeleri";
"This holds state for apps that download content in the background. Deleting it can interrupt downloads in progress, which then have to start over." = "Bu, içeriği arka planda indiren uygulamaların durumunu tutar. Silmek devam eden indirmeleri kesebilir; bunların baştan başlaması gerekir.";

"Siri Knowledge Engine" = "Siri Bilgi Motoru";
"Used by a background Apple service that helps Siri and Spotlight understand natural language. Safe to delete; it is rebuilt automatically." = "Siri ve Spotlight'ın doğal dili anlamasına yardımcı olan bir Apple arka plan servisi tarafından kullanılır. Silmek güvenlidir; otomatik olarak yeniden oluşturulur.";

"Apple Wallet Passes" = "Apple Wallet Kartları";
"Temporary data for passes in Apple Wallet, such as boarding passes and loyalty cards. Safe to delete, but Wallet may need to re-sync them." = "Apple Wallet'taki biniş kartları ve sadakat kartları gibi kartların geçici verileri. Silmek güvenlidir ancak Wallet'ın bunları yeniden eşitlemesi gerekebilir.";

"Siri Suggestions Data" = "Siri Önerileri Verileri";
"This is what Siri Suggestions has learned about your habits and routines. Deleting it resets those personalised suggestions until Siri learns them again." = "Bu, Siri Önerileri'nin alışkanlıklarınız ve rutinleriniz hakkında öğrendikleridir. Silmek, Siri bunları yeniden öğrenene kadar bu kişiselleştirilmiş önerileri sıfırlar.";

"Reminders Service" = "Anımsatıcılar Servisi";
"This is temporary data used by the Reminders app in the background. Deleting it is safe but the Reminders app may need a moment to reload when next opened." = "Bu, Anımsatıcılar uygulamasının arka planda kullandığı geçici verilerdir. Silmek güvenlidir ancak Anımsatıcılar uygulamasının bir sonraki açılışta yeniden yüklenmesi biraz sürebilir.";

"Safari Browser" = "Safari Tarayıcısı";
"Safari's temporary browsing data, such as website previews and recent page data. Websites may load a little slower until it rebuilds." = "Safari'nin web sitesi önizlemeleri ve son sayfa verileri gibi geçici gezinme verileri. Yeniden oluşana kadar web siteleri biraz daha yavaş yüklenebilir.";

"Shazam Music ID" = "Shazam Müzik Tanıma";
"This stores temporary data downloaded by Shazam to help identify music. It is completely safe to delete and Shazam will re-download what it needs." = "Bu, Shazam'ın müziği tanımaya yardımcı olmak için indirdiği geçici verileri saklar. Silmek tamamen güvenlidir ve Shazam ihtiyacı olanı yeniden indirir.";

"Siri Voice Data" = "Siri Ses Verileri";
"This stores temporary voice and speech data used by Siri to speak responses. It is safe to delete and Siri will rebuild it automatically." = "Bu, Siri'nin yanıtları seslendirmek için kullandığı geçici ses ve konuşma verilerini saklar. Silmek güvenlidir ve Siri bunu otomatik olarak yeniden oluşturur.";

"Spotlight Search" = "Spotlight Araması";
"The index Spotlight uses to search your Mac. Nothing is lost, but search is slow or incomplete until macOS rebuilds the index, which can take a while." = "Spotlight'ın Mac'inizde arama yapmak için kullandığı dizin. Hiçbir şey kaybolmaz ancak macOS dizini yeniden oluşturana kadar arama yavaş veya eksik olur; bu biraz zaman alabilir.";

"macOS Tips App" = "macOS İpuçları Uygulaması";
"This stores temporary data for the Tips app that shows you helpful macOS features. It is completely safe to delete." = "Bu, size yararlı macOS özelliklerini gösteren İpuçları uygulamasının geçici verilerini saklar. Silmek tamamen güvenlidir.";

"FaceTime & Video Calls" = "FaceTime ve Görüntülü Aramalar";
"This is temporary data used by FaceTime and other Apple video calling features. It is safe to delete and will be recreated as needed." = "Bu, FaceTime'ın ve diğer Apple görüntülü arama özelliklerinin kullandığı geçici verilerdir. Silmek güvenlidir ve gerektiğinde yeniden oluşturulur.";

"Datadog Monitoring" = "Datadog İzleme";
"This stores temporary data for Datadog, a developer monitoring and analytics tool. It is safe to delete and will be recreated if Datadog is running." = "Bu, bir geliştirici izleme ve analiz aracı olan Datadog'un geçici verilerini saklar. Silmek güvenlidir ve Datadog çalışıyorsa yeniden oluşturulur.";

"Google App Updater" = "Google Uygulama Güncelleyicisi";
"Temporary files Google's updater uses to keep apps like Chrome up to date. They are created again at the next update check." = "Google'ın güncelleyicisinin Chrome gibi uygulamaları güncel tutmak için kullandığı geçici dosyalar. Bir sonraki güncelleme denetiminde yeniden oluşturulur.";

"Microsoft Auto-Updater" = "Microsoft Otomatik Güncelleyici";
"This holds temporary files used by Microsoft AutoUpdate to keep apps like Word and Excel up to date. It is safe to delete and will be recreated automatically." = "Bu, Microsoft AutoUpdate'in Word ve Excel gibi uygulamaları güncel tutmak için kullandığı geçici dosyaları tutar. Silmek güvenlidir ve otomatik olarak yeniden oluşturulur.";

"Edge Browser Updater" = "Edge Tarayıcı Güncelleyicisi";
"These are temporary files used to update the Microsoft Edge browser. They are safe to delete and will be recreated when Edge next checks for updates." = "Bunlar Microsoft Edge tarayıcısını güncellemek için kullanılan geçici dosyalardır. Silmek güvenlidir ve Edge bir sonraki güncelleme denetiminde bunları yeniden oluşturur.";

"NT-ware Print Client" = "NT-ware Yazdırma İstemcisi";
"Used by NT-ware's SmartClient, a print management tool common in offices and universities. Usually safe to delete, but the client may set itself up again." = "Ofislerde ve üniversitelerde yaygın bir yazdırma yönetim aracı olan NT-ware'in SmartClient'ı tarafından kullanılır. Genellikle silmek güvenlidir ancak istemci kendini yeniden kurabilir.";

"OpenAI Codex" = "OpenAI Codex";
"Page and script caches of the Codex app and command line tool, rebuilt as you use it. Your sessions and sign-in in ~/.codex are left alone." = "Codex uygulamasının ve komut satırı aracının sayfa ve betik önbellekleri; kullandıkça yeniden oluşturulur. ~/.codex içindeki oturumlarınıza ve girişinize dokunulmaz.";

"ToDesktop App Updater" = "ToDesktop Uygulama Güncelleyicisi";
"This stores temporary files used by apps built with ToDesktop to deliver updates. It is safe to delete." = "Bu, ToDesktop ile oluşturulan uygulamaların güncelleme sunmak için kullandığı geçici dosyaları saklar. Silmek güvenlidir.";

"Arc / Dia Browser" = "Arc / Dia Tarayıcısı";
"This stores temporary data for the Arc or Dia web browser. Deleting it is safe but the browser may reload some website data more slowly on next launch." = "Bu, Arc veya Dia web tarayıcısının geçici verilerini saklar. Silmek güvenlidir ancak tarayıcı bir sonraki açılışta bazı web sitesi verilerini daha yavaş yükleyebilir.";

"Family Sharing Service" = "Aile Paylaşımı Servisi";
"Temporary data for Family Sharing. Nothing is lost, but family and sharing settings may take a moment to re-sync." = "Aile Paylaşımı'nın geçici verileri. Hiçbir şey kaybolmaz ancak aile ve paylaşım ayarlarının yeniden eşitlenmesi biraz sürebilir.";

"Purge App" = "Purge Uygulaması";
"This is temporary data created by the Purge app itself. It is safe to delete." = "Bu, Purge uygulamasının kendisinin oluşturduğu geçici verilerdir. Silmek güvenlidir.";

"Sentry Error Reports" = "Sentry Hata Raporları";
"This stores temporary error and crash reports collected by Sentry, a tool used by developers to track app issues. It is safe to delete." = "Bu, geliştiricilerin uygulama sorunlarını izlemek için kullandığı Sentry'nin topladığı geçici hata ve çökme raporlarını saklar. Silmek güvenlidir.";

"Playwright Browsers" = "Playwright Tarayıcıları";
"Browsers Playwright downloaded for automated website testing. Your tests fail until you run npx playwright install, which downloads them again." = "Playwright'ın otomatik web sitesi testi için indirdiği tarayıcılar. npx playwright install komutunu çalıştırıp bunları yeniden indirene kadar testleriniz başarısız olur.";

"Unused Playwright Browsers" = "Kullanılmayan Playwright Tarayıcıları";
"Browser builds no Playwright install still lists. A project that never ran npx playwright install may use one. That command downloads it again." = "Hiçbir Playwright kurulumunun hâlâ listelemediği tarayıcı sürümleri. npx playwright install hiç çalıştırmamış bir proje bunlardan birini kullanıyor olabilir. Bu komut onu yeniden indirir.";

"Node.js Packages" = "Node.js Paketleri";
"Code libraries installed for developer projects. Safe to remove for stale projects — run npm install to restore them anytime." = "Geliştirici projeleri için yüklenmiş kod kitaplıkları. Eski projeler için kaldırmak güvenlidir — istediğiniz zaman npm install çalıştırarak geri yükleyin.";

"Prisma Database Tool" = "Prisma Veritabanı Aracı";
"This stores temporary files used by Prisma, a developer database tool. It is safe to delete and will be regenerated when Prisma is next used." = "Bu, bir geliştirici veritabanı aracı olan Prisma'nın kullandığı geçici dosyaları saklar. Silmek güvenlidir ve Prisma bir sonraki kullanıldığında yeniden oluşturulur.";

"Segment Analytics" = "Segment Analitik";
"This stores temporary data for Segment, a tool developers use to collect usage analytics. It is safe to delete." = "Bu, geliştiricilerin kullanım analizi toplamak için kullandığı Segment'in geçici verilerini saklar. Silmek güvenlidir.";

"Apple Software Update" = "Apple Yazılım Güncelleme";
"This is temporary data used by Apple's software update system. It is safe to delete and will be recreated when your Mac next checks for updates." = "Bu, Apple'ın yazılım güncelleme sisteminin kullandığı geçici verilerdir. Silmek güvenlidir ve Mac'iniz bir sonraki güncelleme denetiminde bunları yeniden oluşturur.";

"macOS Installer" = "macOS Yükleyicisi";
"A full macOS installer, usually 12 to 15 GB. macOS does not need it after installing, and the App Store has it. Keep it to make a bootable USB installer." = "Genellikle 12 ila 15 GB boyutunda tam bir macOS yükleyicisi. macOS yükleme sonrasında buna ihtiyaç duymaz ve App Store'da mevcuttur. Önyüklenebilir bir USB yükleyici yapmak için saklayın.";

"Leftover macOS update files" = "Artık macOS güncelleme dosyaları";
"Install files a finished macOS update left behind, counted as System Data. Only shown when older than the installed macOS, so a waiting update never is." = "Tamamlanmış bir macOS güncellemesinin geride bıraktığı, Sistem Verileri olarak sayılan kurulum dosyaları. Yalnızca yüklü macOS'ten eskiyse gösterilir, bu yüzden bekleyen bir güncelleme asla gösterilmez.";

"Flutter Dev Tool" = "Flutter Geliştirici Aracı";
"A temporary folder used by the Dart and Flutter development tools. Safe to delete and will be recreated automatically the next time you run a Flutter project." = "Dart ve Flutter geliştirme araçlarının kullandığı geçici bir klasör. Silmek güvenlidir ve bir Flutter projesini bir sonraki çalıştırışınızda otomatik olarak yeniden oluşturulur.";

"App Store Migration Tool" = "App Store Taşıma Aracı";
"This is a temporary folder used by Apple's App Store services to migrate account or media data. It is safe to delete." = "Bu, Apple'ın App Store servislerinin hesap veya medya verilerini taşımak için kullandığı geçici bir klasördür. Silmek güvenlidir.";

"Spokenly App" = "Spokenly Uygulaması";
"This stores temporary data for the Spokenly app. It is safe to delete and will be recreated when the app is next used." = "Bu, Spokenly uygulamasının geçici verilerini saklar. Silmek güvenlidir ve uygulama bir sonraki kullanıldığında yeniden oluşturulur.";

"App Archives" = "Uygulama Arşivleri";
"Archived builds created by development tools. Check contents before deleting — may contain important project archives." = "Geliştirme araçlarının oluşturduğu arşivlenmiş derlemeler. Silmeden önce içeriği kontrol edin — önemli proje arşivleri içerebilir.";

"App Sandbox Manager" = "Uygulama Korumalı Alan Yöneticisi";
"Used by the macOS service that manages each app's private storage. Usually safe to delete, but some apps may need to set their storage up again." = "Her uygulamanın özel depolama alanını yöneten macOS servisi tarafından kullanılır. Genellikle silmek güvenlidir ancak bazı uygulamaların depolama alanlarını yeniden kurması gerekebilir.";

"In-App Purchase Service" = "Uygulama İçi Satın Alma Servisi";
"Temporary data for in-app purchases and App Store transactions. Nothing is lost, but apps may ask you to restore purchases or sign in again." = "Uygulama içi satın almaların ve App Store işlemlerinin geçici verileri. Hiçbir şey kaybolmaz ancak uygulamalar satın alımları geri yüklemenizi veya yeniden oturum açmanızı isteyebilir.";

"Docker Desktop" = "Docker Desktop";
"All images, containers and volumes; some hold databases. To keep volumes, run docker --context desktop-linux system prune while Docker is open or quit Docker." = "Tüm imajlar, kapsayıcılar ve birimler; bazıları veritabanı barındırır. Birimleri korumak için Docker açıkken veya Docker'dan çıkmışken docker --context desktop-linux system prune komutunu çalıştırın.";

"Raycast Launcher" = "Raycast Başlatıcısı";
"This stores temporary data for Raycast, a productivity launcher app. It is safe to delete and Raycast will rebuild it automatically." = "Bu, bir üretkenlik başlatıcı uygulaması olan Raycast'in geçici verilerini saklar. Silmek güvenlidir ve Raycast bunu otomatik olarak yeniden oluşturur.";

"Xcode Build Files" = "Xcode Derleme Dosyaları";
"Temporary files Xcode creates while building apps. Always safe to delete — your next build will just take a little longer." = "Xcode'un uygulamaları derlerken oluşturduğu geçici dosyalar. Silmek her zaman güvenlidir — bir sonraki derlemeniz biraz daha uzun sürer.";

"Swift Package Manager" = "Swift Paket Yöneticisi";
"Swift packages downloaded for your projects. Each project downloads its dependencies again the next time you build it." = "Projeleriniz için indirilen Swift paketleri. Her proje, bir sonraki derlemenizde bağımlılıklarını yeniden indirir.";

"Zen Browser" = "Zen Tarayıcısı";
"This stores temporary data for the Zen web browser. Deleting it is safe but the browser may reload some website data more slowly on next launch." = "Bu, Zen web tarayıcısının geçici verilerini saklar. Silmek güvenlidir ancak tarayıcı bir sonraki açılışta bazı web sitesi verilerini daha yavaş yükleyebilir.";

"Xcode Device Support" = "Xcode Aygıt Desteği";
"Temporary files Xcode uses to install and test apps on connected Apple devices. Safe to delete, but Xcode may download device support files again." = "Xcode'un bağlı Apple aygıtlarına uygulama yüklemek ve test etmek için kullandığı geçici dosyalar. Silmek güvenlidir ancak Xcode aygıt desteği dosyalarını yeniden indirebilir.";

"Game Center Service" = "Game Center Servisi";
"This stores temporary data for Apple's Game Center, which manages game scores and achievements. It is safe to delete and will be rebuilt automatically." = "Bu, oyun skorlarını ve başarımları yöneten Apple Game Center'ın geçici verilerini saklar. Silmek güvenlidir ve otomatik olarak yeniden oluşturulur.";

"Widgets Cache" = "Widget Önbelleği";
"Saved snapshots of your desktop and Notification Center widgets. Safe to delete; widgets draw themselves again and may look blank for a moment until they do." = "Masaüstü ve Bildirim Merkezi widget'larınızın kayıtlı anlık görüntüleri. Silmek güvenlidir; widget'lar kendilerini yeniden çizer ve bunu yapana kadar kısa süre boş görünebilir.";

"Translation Service" = "Çeviri Servisi";
"This stores temporary data used by macOS's built-in translation feature. It is safe to delete and the translation service will rebuild it as needed." = "Bu, macOS'in yerleşik çeviri özelliğinin kullandığı geçici verileri saklar. Silmek güvenlidir ve çeviri servisi gerektiğinde bunu yeniden oluşturur.";

"Figma Desktop Agent" = "Figma Masaüstü Aracısı";
"This stores temporary data for Figma's background helper that enables font access and desktop features. It is safe to delete." = "Bu, yazı tipi erişimini ve masaüstü özelliklerini sağlayan Figma'nın arka plan yardımcısının geçici verilerini saklar. Silmek güvenlidir.";

"GameKit Framework" = "GameKit Çerçevesi";
"This stores temporary data for Apple's gaming framework used by game apps. It is safe to delete and will be rebuilt when a game app is next opened." = "Bu, oyun uygulamalarının kullandığı Apple'ın oyun çerçevesinin geçici verilerini saklar. Silmek güvenlidir ve bir oyun uygulaması bir sonraki açıldığında yeniden oluşturulur.";

"Image Thumbnail Cache" = "Görsel Küçük Resim Önbelleği";
"Saved image previews and thumbnails that speed up display in apps. Safe to delete; images load a little slower until the previews rebuild." = "Uygulamalarda görüntülemeyi hızlandıran kayıtlı görsel önizlemeleri ve küçük resimler. Silmek güvenlidir; önizlemeler yeniden oluşana kadar görseller biraz daha yavaş yüklenir.";

"RevenueCat Purchases" = "RevenueCat Satın Alımları";
"This stores temporary data for RevenueCat, a tool that apps use to manage in-app subscriptions and purchases. It is safe to delete." = "Bu, uygulamaların uygulama içi abonelikleri ve satın alımları yönetmek için kullandığı RevenueCat'in geçici verilerini saklar. Silmek güvenlidir.";

"Git Worktree Checkouts" = "Git Worktree Çıkışları";
"Forgotten branch checkouts created by Git. Safe to remove if you are no longer working on those branches, but check first that you have no unsaved work." = "Git'in oluşturduğu unutulmuş dal çıkışları. Bu dallarda artık çalışmıyorsanız kaldırmak güvenlidir ancak önce kaydedilmemiş çalışmanız olmadığından emin olun.";

"VS Code Cache" = "VS Code Önbelleği";
"Temporary files stored by Visual Studio Code. Safe to delete and will be recreated when you open VS Code again." = "Visual Studio Code'un sakladığı geçici dosyalar. Silmek güvenlidir ve VS Code'u yeniden açtığınızda yeniden oluşturulur.";

"Cursor Cache" = "Cursor Önbelleği";
"Temporary files stored by the Cursor code editor. Safe to delete and will be recreated when you open Cursor again." = "Cursor kod düzenleyicisinin sakladığı geçici dosyalar. Silmek güvenlidir ve Cursor'u yeniden açtığınızda yeniden oluşturulur.";

"JetBrains IDE Cache" = "JetBrains IDE Önbelleği";
"Indexes and caches JetBrains IDEs rebuild on their own. Local History is left alone. Each project re-indexes when you next open it, which takes a few minutes." = "JetBrains IDE'lerinin kendi kendine yeniden oluşturduğu dizinler ve önbellekler. Yerel Geçmiş'e dokunulmaz. Her proje bir sonraki açışınızda yeniden dizinlenir; bu birkaç dakika sürer.";

"Zed Editor Cache" = "Zed Düzenleyici Önbelleği";
"Temporary files stored by the Zed code editor. Safe to delete and will be recreated when you open Zed again." = "Zed kod düzenleyicisinin sakladığı geçici dosyalar. Silmek güvenlidir ve Zed'i yeniden açtığınızda yeniden oluşturulur.";

"Go Module Cache" = "Go Modül Önbelleği";
"Cached Go packages and build outputs. Safe to delete and will be re-downloaded when you build your Go projects again." = "Önbelleğe alınmış Go paketleri ve derleme çıktıları. Silmek güvenlidir ve Go projelerinizi yeniden derlediğinizde yeniden indirilir.";

"Maven Package Cache" = "Maven Paket Önbelleği";
"Maven's downloaded libraries and your own mvn install builds. Libraries download again on your next build; your own builds come back only if you rebuild them." = "Maven'in indirdiği kitaplıklar ve kendi mvn install derlemeleriniz. Kitaplıklar bir sonraki derlemenizde yeniden indirilir; kendi derlemeleriniz yalnızca yeniden derlerseniz geri gelir.";

"Ivy Dependency Cache" = "Ivy Bağımlılık Önbelleği";
"Java and Scala libraries downloaded by sbt and Ivy. Nothing is lost, but the next build downloads them all again, which is slow and needs a connection." = "sbt ve Ivy'nin indirdiği Java ve Scala kitaplıkları. Hiçbir şey kaybolmaz ancak bir sonraki derleme hepsini yeniden indirir; bu yavaştır ve bağlantı gerektirir.";

"Ruby Gem Downloads" = "Ruby Gem İndirmeleri";
"Downloaded .gem files and the spec index RubyGems keeps after installing. Your installed gems stay; RubyGems downloads these again when needed." = "RubyGems'in yüklemeden sonra tuttuğu indirilmiş .gem dosyaları ve spec dizini. Yüklü gem'leriniz kalır; RubyGems bunları gerektiğinde yeniden indirir.";

"Bundler Cache" = "Bundler Önbelleği";
"Cached Ruby gems downloaded by Bundler. Safe to delete and will be re-downloaded when you run bundle install." = "Bundler'ın indirdiği önbelleğe alınmış Ruby gem'leri. Silmek güvenlidir ve bundle install çalıştırdığınızda yeniden indirilir.";

"Composer Cache" = "Composer Önbelleği";
"Cached PHP packages downloaded by Composer. Safe to delete and will be re-downloaded when you run composer install." = "Composer'ın indirdiği önbelleğe alınmış PHP paketleri. Silmek güvenlidir ve composer install çalıştırdığınızda yeniden indirilir.";

"Rust Package Cache" = "Rust Paket Önbelleği";
"Cached Rust packages and compiled dependencies. Safe to delete and will be re-downloaded when you build your Rust projects." = "Önbelleğe alınmış Rust paketleri ve derlenmiş bağımlılıklar. Silmek güvenlidir ve Rust projelerinizi derlediğinizde yeniden indirilir.";

"Terraform Plugin Cache" = "Terraform Eklenti Önbelleği";
"Cached Terraform provider plugins. Safe to delete and will be re-downloaded when you run terraform init." = "Önbelleğe alınmış Terraform sağlayıcı eklentileri. Silmek güvenlidir ve terraform init çalıştırdığınızda yeniden indirilir.";

"GitHub Actions Cache" = "GitHub Actions Önbelleği";
"Cached files used when running GitHub Actions locally. Safe to delete and will be recreated automatically." = "GitHub Actions yerel olarak çalıştırılırken kullanılan önbelleğe alınmış dosyalar. Silmek güvenlidir ve otomatik olarak yeniden oluşturulur.";

"Vagrant Box Cache" = "Vagrant Box Önbelleği";
"Virtual machine images used by Vagrant. Safe to delete if unused — re-downloading takes a while." = "Vagrant'ın kullandığı sanal makine imajları. Kullanılmıyorsa silmek güvenlidir — yeniden indirmek biraz zaman alır.";

"Zsh Session Cache" = "Zsh Oturum Önbelleği";
"Temporary files created by your terminal shell. Safe to delete and will be recreated automatically when you open a new terminal window." = "Terminal kabuğunuzun oluşturduğu geçici dosyalar. Silmek güvenlidir ve yeni bir terminal penceresi açtığınızda otomatik olarak yeniden oluşturulur.";

"Electron App Cache" = "Electron Uygulama Önbelleği";
"Temporary files stored by apps built with Electron like Slack, Discord, and Notion. Safe to delete and will be recreated automatically." = "Slack, Discord ve Notion gibi Electron ile oluşturulmuş uygulamaların sakladığı geçici dosyalar. Silmek güvenlidir ve otomatik olarak yeniden oluşturulur.";

"Application Logs" = "Uygulama Günlükleri";
"Log files created by apps to record what they are doing. Safe to delete. Apps will create new log files automatically." = "Uygulamaların ne yaptıklarını kaydetmek için oluşturduğu günlük dosyaları. Silmek güvenlidir. Uygulamalar yeni günlük dosyalarını otomatik olarak oluşturur.";

"Crash Reports" = "Çökme Raporları";
"Records of app crashes saved by macOS. Safe to delete. These are only useful if you are reporting a bug to an app developer." = "macOS'in kaydettiği uygulama çökme kayıtları. Silmek güvenlidir. Bunlar yalnızca bir uygulama geliştiricisine hata bildiriyorsanız işe yarar.";

"iOS Simulators" = "iOS Simülatörleri";
"Virtual iPhone and iPad devices Xcode tests apps on. Deleting one also deletes its apps and data. Xcode can create a new one when you need it." = "Xcode'un uygulamaları test ettiği sanal iPhone ve iPad aygıtları. Birini silmek uygulamalarını ve verilerini de siler. Xcode ihtiyaç duyduğunuzda yenisini oluşturabilir.";

"Bun Package Cache" = "Bun Paket Önbelleği";
"Packages downloaded by Bun, a JavaScript runtime and package manager. Safe to delete; they download again the next time you run bun install." = "Bir JavaScript çalışma zamanı ve paket yöneticisi olan Bun'ın indirdiği paketler. Silmek güvenlidir; bun install komutunu bir sonraki çalıştırışınızda yeniden indirilir.";

"Deno Module Cache" = "Deno Modül Önbelleği";
"Cached modules downloaded by Deno, a JavaScript and TypeScript runtime. Safe to delete and will be re-downloaded when you next run a Deno project." = "Bir JavaScript ve TypeScript çalışma zamanı olan Deno'nun indirdiği önbelleğe alınmış modüller. Silmek güvenlidir ve bir Deno projesini bir sonraki çalıştırışınızda yeniden indirilir.";

"Turborepo Build Cache" = "Turborepo Derleme Önbelleği";
"Saved build outputs from Turborepo, a build tool for JavaScript monorepos. Safe to delete. Your next build will simply take a little longer as it rebuilds from scratch." = "JavaScript monorepo'ları için bir derleme aracı olan Turborepo'nun kayıtlı derleme çıktıları. Silmek güvenlidir. Bir sonraki derlemeniz sıfırdan yeniden oluşturulacağı için biraz daha uzun sürer.";

"Mise Cache" = "Mise Önbelleği";
"Version lists and other data cached by Mise (formerly rtx), a tool version manager. Installed tools stay, and Mise fetches the rest again." = "Bir araç sürüm yöneticisi olan Mise'in (eski adıyla rtx) önbelleğe aldığı sürüm listeleri ve diğer veriler. Yüklü araçlar kalır ve Mise gerisini yeniden getirir.";

"Next.js Build Cache" = "Next.js Derleme Önbelleği";
"Temporary build files created by Next.js. Safe to delete and will be recreated the next time you build or run your Next.js project." = "Next.js'in oluşturduğu geçici derleme dosyaları. Silmek güvenlidir ve Next.js projenizi bir sonraki derleyişinizde veya çalıştırışınızda yeniden oluşturulur.";

"Vite Build Cache" = "Vite Derleme Önbelleği";
"Temporary files created by Vite, a fast frontend build tool. Safe to delete and will be regenerated when you next start your project." = "Hızlı bir ön yüz derleme aracı olan Vite'in oluşturduğu geçici dosyalar. Silmek güvenlidir ve projenizi bir sonraki başlatışınızda yeniden oluşturulur.";

"Parcel Build Cache" = "Parcel Derleme Önbelleği";
"Saved build outputs from the Parcel bundler. Safe to delete and will be rebuilt next time you run a Parcel build." = "Parcel paketleyicisinin kayıtlı derleme çıktıları. Silmek güvenlidir ve bir sonraki Parcel derlemenizde yeniden oluşturulur.";

"ESLint Cache" = "ESLint Önbelleği";
"Saved results from ESLint, a JavaScript code checker. Safe to delete. ESLint will simply re-check all your files on the next run." = "Bir JavaScript kod denetleyicisi olan ESLint'in kayıtlı sonuçları. Silmek güvenlidir. ESLint bir sonraki çalışmasında tüm dosyalarınızı yeniden denetler.";

"Jest Test Cache" = "Jest Test Önbelleği";
"Temporary files saved by Jest, a JavaScript testing tool, to make tests run faster. Safe to delete and will be recreated on the next test run." = "Bir JavaScript test aracı olan Jest'in testleri hızlandırmak için kaydettiği geçici dosyalar. Silmek güvenlidir ve bir sonraki test çalışmasında yeniden oluşturulur.";

"Vitest Test Cache" = "Vitest Test Önbelleği";
"Temporary files saved by Vitest to speed up test runs. Safe to delete and will be recreated automatically." = "Vitest'in test çalışmalarını hızlandırmak için kaydettiği geçici dosyalar. Silmek güvenlidir ve otomatik olarak yeniden oluşturulur.";

"Cypress Test Binaries" = "Cypress Test İkili Dosyaları";
"The Cypress app that runs your end-to-end tests. Tests fail until you run npx cypress install, which downloads it again." = "Uçtan uca testlerinizi çalıştıran Cypress uygulaması. npx cypress install komutunu çalıştırıp yeniden indirene kadar testler başarısız olur.";

"Python Bytecode Cache" = "Python Bayt Kodu Önbelleği";
"Compiled Python files that make your code run faster. Safe to delete and Python will recreate them automatically when your code runs again." = "Kodunuzun daha hızlı çalışmasını sağlayan derlenmiş Python dosyaları. Silmek güvenlidir ve kodunuz yeniden çalıştığında Python bunları otomatik olarak yeniden oluşturur.";

"uv Package Cache" = "uv Paket Önbelleği";
"Cached Python packages downloaded by uv, a fast Python package manager. Safe to delete and will be re-downloaded when you next install packages." = "Hızlı bir Python paket yöneticisi olan uv'nin indirdiği önbelleğe alınmış Python paketleri. Silmek güvenlidir ve bir sonraki paket yüklemenizde yeniden indirilir.";

"Ruff Linter Cache" = "Ruff Linter Önbelleği";
"Saved results from Ruff, a fast Python code checker. Safe to delete and will be recreated on the next run." = "Hızlı bir Python kod denetleyicisi olan Ruff'ın kayıtlı sonuçları. Silmek güvenlidir ve bir sonraki çalışmada yeniden oluşturulur.";

"Mypy Type Check Cache" = "Mypy Tür Denetimi Önbelleği";
"Saved results from Mypy, a Python type checker. Safe to delete and will be rebuilt next time Mypy runs." = "Bir Python tür denetleyicisi olan Mypy'ın kayıtlı sonuçları. Silmek güvenlidir ve Mypy bir sonraki çalıştığında yeniden oluşturulur.";

"Kotlin Build Cache" = "Kotlin Derleme Önbelleği";
"Compiled Kotlin build files. Safe to delete and will be rebuilt the next time you build your Kotlin project." = "Derlenmiş Kotlin derleme dosyaları. Silmek güvenlidir ve Kotlin projenizi bir sonraki derleyişinizde yeniden oluşturulur.";

"Android Build Output" = "Android Derleme Çıktısı";
"Compiled Android app files. Safe to delete — your project will rebuild automatically next time." = "Derlenmiş Android uygulama dosyaları. Silmek güvenlidir — projeniz bir sonraki sefer otomatik olarak yeniden derlenir.";

"Gradle Build Cache" = "Gradle Derleme Önbelleği";
"A project's own Gradle state, such as file hashes and build history. The next build recreates it; downloaded libraries live in ~/.gradle." = "Bir projenin dosya özetleri ve derleme geçmişi gibi kendi Gradle durumu. Bir sonraki derleme bunu yeniden oluşturur; indirilen kitaplıklar ~/.gradle içinde bulunur.";

"Gradle Dependency Cache" = "Gradle Bağımlılık Önbelleği";
"Gradle's downloaded libraries, build cache and wrapper versions. Nothing is lost, but the next build downloads and rebuilds them, which is slow." = "Gradle'ın indirdiği kitaplıklar, derleme önbelleği ve wrapper sürümleri. Hiçbir şey kaybolmaz ancak bir sonraki derleme bunları indirir ve yeniden oluşturur; bu yavaştır.";

"CocoaPods Cache" = "CocoaPods Önbelleği";
"Cached iOS and macOS library files downloaded by CocoaPods. Safe to delete and will be re-downloaded when you run pod install." = "CocoaPods'un indirdiği önbelleğe alınmış iOS ve macOS kitaplık dosyaları. Silmek güvenlidir ve pod install çalıştırdığınızda yeniden indirilir.";

"CocoaPods Spec Repos" = "CocoaPods Spec Depoları";
"Spec repos CocoaPods uses to look up libraries. The public one comes back on your next pod install; private ones from pod repo add must be added again." = "CocoaPods'un kitaplıkları aramak için kullandığı spec depoları. Genel olan bir sonraki pod install ile geri gelir; pod repo add ile eklenen özel olanlar yeniden eklenmelidir.";

"Swift Build Artifacts" = "Swift Derleme Çıktıları";
"Compiled Swift build files. Safe to delete and will be rebuilt the next time you build your Swift project." = "Derlenmiş Swift derleme dosyaları. Silmek güvenlidir ve Swift projenizi bir sonraki derleyişinizde yeniden oluşturulur.";

"Rust Build Output" = "Rust Derleme Çıktısı";
"Compiled Rust project files. Safe to delete — your project will recompile automatically on the next build." = "Derlenmiş Rust proje dosyaları. Silmek güvenlidir — projeniz bir sonraki derlemede otomatik olarak yeniden derlenir.";

"Flutter Build Cache" = "Flutter Derleme Önbelleği";
"Temporary build files created by Flutter. Safe to delete and will be recreated the next time you build your Flutter app." = "Flutter'ın oluşturduğu geçici derleme dosyaları. Silmek güvenlidir ve Flutter uygulamanızı bir sonraki derleyişinizde yeniden oluşturulur.";

"Dart Pub Cache" = "Dart Pub Önbelleği";
